# ==============================================================================
# AdventureX AWS Production Cloud Environment Template
# ==============================================================================

# AWS Core Region
VITE_AWS_REGION=ap-south-1

# API Gateway & Backend Base URL
VITE_API_BASE_URL=https://api.adventurex.in/v1

# Amazon Simple Storage Service (S3) Media Bucket
VITE_S3_BUCKET_NAME=adventurex-media-prod-ap-south-1

# Amazon CloudFront CDN Distribution
VITE_CLOUDFRONT_DOMAIN=https://d123456abcdef8.cloudfront.net

# Amazon Cognito User Pool & Identity Configuration
VITE_COGNITO_USER_POOL_ID=ap-south-1_AdvxPool2026
VITE_COGNITO_APP_CLIENT_ID=4abcdefghij1234567890klmno
VITE_COGNITO_IDENTITY_POOL_ID=ap-south-1:12345678-abcd-1234-abcd-1234567890ab

# Application Mode
VITE_APP_ENV=production
